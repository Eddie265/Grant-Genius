# ─── Neon Postgres (managed by `neon deploy` / `neon env pull`) ───
# Pooled connection: app runtime queries (Prisma Client)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require&channel_binding=require"
# Direct connection: Prisma migrations / db push
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"
# Max pooled connections per server instance (default 5); 1 is most reliable on slow networks
DATABASE_POOL_MAX=1
NEON_BRANCH=production

# ─── Admin access (comma-separated emails promoted to ADMIN on sign-in) ───
ADMIN_EMAILS=

# ─── Public site address (share previews, canonical links, sitemap) ───
# Set to your production domain, e.g. https://grantgenius.africa
SITE_URL=

# ─── NextAuth ───
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ─── Groq (active AI provider for proposal generation) ───
GROQ_API_KEY=
AI_PROVIDER=groq
# Optional: override the Groq model (default openai/gpt-oss-120b)
GROQ_MODEL=

# ─── OpenAI (set AI_PROVIDER=openai to use it) ───
OPENAI_API_KEY=

# ─── Anthropic Claude (optional second AI provider) ───
ANTHROPIC_API_KEY=

# ─── Express API server (npm run server) ───
PORT=5000
